# ============================================================
# WorkFlow Pro — Backend Environment Configuration Example
# ============================================================
# Copy this file to .env and replace placeholder values with your actual configuration.
# DO NOT commit real secrets or credentials to source control.

# --- Database ---
# Local PostgreSQL Docker default or remote PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://workflow:password@localhost:5432/workflow_pro

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_this_to_a_secure_random_64_character_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App Settings ---
APP_NAME=WorkFlow Pro
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed origins (e.g. your Render frontend URL)
CORS_ORIGINS=https://workflow-pro-bn80.onrender.com,http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Attendance Rules ---
WORKDAY_START_TIME=09:30
LATE_GRACE_MINUTES=15

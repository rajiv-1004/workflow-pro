# ============================================================
# WorkFlow Pro — Root .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# --- Environment Variables ---
.env
.env.*
!.env.example
*.local

# --- Database & Cache ---
*.sqlite
*.sqlite3
*.db
*.db-journal

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# --- Frontend (Node & Build) ---
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vitest/

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# --- Operating System ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Logs & Temp ---
*.log
logs/
tmp/
temp/
